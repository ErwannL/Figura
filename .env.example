# Copy to .env and replace every value. Secrets: at least 32 random characters each
# (e.g. `openssl rand -base64 36`). Never commit .env.

# --- Database (compose) ---
POSTGRES_PASSWORD=change-me-postgres-password

# --- Figura app ---
# Signs nothing sent to clients; peppers session ids. Must differ from FIGURA_SSO_SECRET.
FIGURA_SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Shared with the Orqea admin console, which signs the SSO JWT (HS256) with it.
FIGURA_SSO_SECRET=change-me-sso-secret-at-least-32-characters
# JWT audience expected in SSO tokens.
FIGURA_APP_ID=figura
# Origins allowed to embed the app in an iframe (CSP frame-ancestors), comma separated.
FIGURA_CONSOLE_ORIGINS=http://localhost:4100
# 404 for any request whose Host is not local. Set false ONLY behind an authenticating reverse proxy.
FIGURA_LOOPBACK_ONLY=true
# true when the console is on another site: cookie becomes SameSite=None; Secure (HTTPS required).
FIGURA_COOKIE_CROSS_SITE=false
# Session length in minutes.
FIGURA_SESSION_TTL_MIN=120
# Public URL printed by `npm run sso:mint`.
FIGURA_PUBLIC_URL=http://localhost:4000
# Target of « Back to Orqea » / « Powered by Orqea » (public, exposed on /health). Default https://orqea.dev.
FIGURA_ORQEA_URL=http://localhost:3001/apps/return

# Named Orqea targets (JSON; app and worker). The admin console signs the name it inspects into the
# SSO token ("target" claim); new runs preselect it. Inside Orqea's compose see docs/ORQEA_INTEGRATION.md.
FIGURA_TARGETS='{"fake":{"api":"http://fake-orqea:4100","web":"http://fake-orqea:4100"}}'

# Bearer of the Vigie service API (docs/VIGIE.md); empty = that API answers 401. Distinct secret.
FIGURA_VIGIE_SECRET=

# --- Worker ---
# Encrypts synthetic account credentials at rest (AES-256-GCM, key derived with scrypt).
FIGURA_DATA_KEY=change-me-data-key-at-least-32-characters
# Shared with the target (Orqea or fake): Bearer for the synthetic admin API + X-Synthetic-Run HMAC.
SYNTHETIC_SERVICE_SECRET=change-me-synthetic-service-secret-32
# Hosts refused as production whatever they report (comma separated).
FIGURA_PRODUCTION_HOSTS=app.orqea.com
# Volume caps (VOLUME_CAP refusal above them).
FIGURA_MAX_ACCOUNTS=500
FIGURA_MAX_RPS=20
FIGURA_MAX_ROWS=100000
# Optional: FIGURA_READY_TIMEOUT_MS=120000, FIGURA_STEP_TIMEOUT_MS=8000, FIGURA_POLL_MS=2000, FIGURA_WORKER_ID=worker-1,
# FIGURA_LOCAL_TARGET_HOSTS=fake-orqea, PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chrome,
# FIGURA_EXPLORER_RETENTION_DAYS=14 (explorer screenshots older than this are purged)

# --- Fake Orqea (dev target) ---
# Friction scenario preset: baseline, improved, unclear-signup, inaccessible, untranslated, slow, all-unlocked
FAKE_SCENARIO=baseline
# Target name the fake console signs into its SSO tokens (like Orqea's "local"/"recette").
FAKE_CONSOLE_TARGET=fake
# Optional: FAKE_SCENARIO_FILE=/path/scenario.json, FAKE_ENV=development, FAKE_STRIPE_MODE=test,
# FAKE_SYNTHETIC_ENABLED=true, FAKE_ADMIN_ALLOWED=172.,10., FAKE_VERSION=fake-orqea-1.0.0
